---
import Icon from './Icon.astro';

interface Badge {
  label: string;
  tone: 'sky' | 'gold';
}

interface Props {
  icon: string;
  title: string;
  description: string;
  variant?: 'large' | 'small';
  tone?: 'paper' | 'deep';
  badges?: Badge[];
  class?: string;
}

const { icon, title, description, variant = 'small', tone = 'paper', badges = [], class: className = '' } = Astro.props;

const isDeep = tone === 'deep';
const isLarge = variant === 'large';
const hasSticker = Astro.slots.has('sticker');

const badgeTone: Record<Badge['tone'], string> = {
  sky: 'bg-sky-data/20 text-mist-paper dark:text-sawah-deep',
  gold: 'bg-sawah-deep text-paddy-gold dark:bg-mist-paper',
};
---

<div
  class={`clay-border rounded-xl hover-lift flex flex-col ${
    isDeep ? 'bg-sawah-deep' : 'bg-mist-paper'
  } ${isLarge ? 'p-8' : 'p-6'} ${className}`}
>
  {/* Sticker illustration — large cards get bigger, small cards get regular */}
  {hasSticker && (
    <div class={`mb-5 flex justify-center ${isLarge ? 'px-0' : 'px-4'}`}>
      <div class={`[&>svg]:block [&>svg]:h-auto [&>svg]:w-full ${isLarge ? 'w-48' : 'w-32'}`}>
        <slot name="sticker" />
      </div>
    </div>
  )}

  {!hasSticker && (
    <div
      class={`flex items-center justify-center rounded-xl ${
        isDeep ? 'bg-mist-paper/10 text-paddy-gold' : 'bg-terrace-green/10 text-terrace-green dark:text-sawah-deep'
      } ${isLarge ? 'h-14 w-14' : 'h-11 w-11'}`}
    >
      <Icon name={icon} class={`${isLarge ? 'h-7 w-7' : 'h-5 w-5'}`} />
    </div>
  )}

  <h3
    class={`mt-5 font-display ${
      isDeep ? 'text-mist-paper' : 'text-sawah-deep'
    } ${isLarge ? 'text-xl' : 'text-lg'}`}
  >
    {title}
  </h3>
  <p class={`mt-2 ${isDeep ? 'text-mist-paper/70' : 'text-sawah-deep/70'} ${isLarge ? 'text-base' : 'text-sm'}`}>
    {description}
  </p>

  {
    badges.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-6">
        {badges.map((b) => (
          <span class={`rounded-md px-3 py-1 font-mono text-data ${badgeTone[b.tone]}`}>{b.label}</span>
        ))}
      </div>
    )
  }
</div>
