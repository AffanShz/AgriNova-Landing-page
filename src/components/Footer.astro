---
import Icon from './Icon.astro';

const perusahaan = [
  { label: 'Tentang Kami', href: '#top' },
  { label: 'Karir', href: '#top' },
  { label: 'Kontak Kami', href: '#top' },
];

const legal = [
  { label: 'Kebijakan Privasi', href: '#top' },
  { label: 'Syarat & Ketentuan', href: '#top' },
  { label: 'Pusat Bantuan', href: '#top' },
];
---

<footer class="bg-sawah-deep">
  <div class="container-agrinova grid grid-cols-1 gap-10 py-14 sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2">
      <a href="#top" class="mb-4 inline-flex items-center gap-3" aria-label="AgriNova">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-terrace-green text-mist-paper">
          <Icon name="leaf" class="h-5 w-5" />
        </span>
        <span class="font-display text-xl font-bold text-mist-paper">AgriNova</span>
      </a>
      <p class="mt-4 max-w-sm text-sm text-mist-paper/60">
        Memberdayakan Petani dengan AI Terestrial. Solusi presisi untuk hasil panen yang lebih baik.
      </p>
      <p class="mt-6 font-mono text-data text-mist-paper/50">© 2024 AgriNova Indonesia.</p>
    </div>

    <div>
      <h4 class="font-sans text-sm font-semibold text-mist-paper">Perusahaan</h4>
      <ul class="mt-4 space-y-2">
        {perusahaan.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-mist-paper/60 transition-colors duration-200 hover:text-paddy-gold">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="font-sans text-sm font-semibold text-mist-paper">Legal</h4>
      <ul class="mt-4 space-y-2">
        {legal.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-mist-paper/60 transition-colors duration-200 hover:text-paddy-gold">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
